FROM python:3.7-slim-bullseye

USER root

# Legacy stack for old DStream Kafka notebooks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    tar \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="$JAVA_HOME/bin:${PATH}"

RUN mkdir -p /opt/java \
    && curl -L "https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jre/hotspot/normal/adoptium" -o /tmp/java8.tar.gz \
    && tar -xzf /tmp/java8.tar.gz -C /opt/java \
    && rm -f /tmp/java8.tar.gz \
    && mv /opt/java/* /opt/java/openjdk

COPY requirements.jupyter.legacy.txt /tmp/requirements.jupyter.legacy.txt
RUN pip install --no-cache-dir -r /tmp/requirements.jupyter.legacy.txt

WORKDIR /home/notebooks

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token="]
